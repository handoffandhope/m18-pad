{
  "manifest_version": 3,
  "name": "M18 Stale Tabs",
  "version": "0.1.0",
  "description": "Shows long-open tabs as cards on the M18 macro pad (Keep / Close / Later / Skip). Reads only tab titles and URLs; never page content.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms", "nativeMessaging", "favicon", "readingList", "sessions"],
  "optional_permissions": ["bookmarks"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" }
}
